<view class="page-root">
<!-- 过滤框：71 条语法点里找一条，比翻目录快 -->
<view class="sb">
  <view class="sb__ico"></view>
  <input class="sb__input" value="{{q}}" confirm-type="search" hold-keyboard="{{true}}"
         placeholder="搜语法点，如 时态 / 从句 / 冠词" placeholder-class="sb__ph"
         bindinput="onInput" bindconfirm="onInput" />
  <view class="sb__clear" wx:if="{{q}}" hover-class="hover-dim" hover-stay-time="120" bindtap="onClear">×</view>
</view>

<!-- 场景筛选（v1.1.68）：按「用在什么场合」再切一刀。体系轴（下面的 12 分类）负责系统学，
     场景轴负责查着用 —— 两条轴共用同一批内容，不新增第二套教材。 -->
<view class="tagbar">
  <view class="tagchip {{tag === '' ? 'on' : ''}}" data-t=""
        hover-class="tagchip--press" hover-stay-time="60" bindtap="onTag">全部</view>
  <view class="tagchip {{tag === item.full ? 'on' : ''}}" wx:for="{{tagList}}" wx:key="full" data-t="{{item.full}}"
        hover-class="tagchip--press" hover-stay-time="60" bindtap="onTag">{{item.short}}</view>
</view>

<!-- ① 关键词搜索命中（优先于场景筛选） -->
<block wx:if="{{q}}">
  <view class="meta" wx:if="{{hits.length}}">找到 {{hits.length}} 个语法点</view>
  <view class="card" wx:if="{{hits.length}}">
    <view class="tp" wx:for="{{hits}}" wx:key="t" data-c="{{item.c}}" data-i="{{item.i}}"
          hover-class="tp--press" hover-stay-time="60" bindtap="onTopic">
      <view class="tp__head"><text class="tp__t">{{item.t}}</text><text class="tp__cat">{{item.catName}}</text><view class="tp__go"></view></view>
      <view class="tp__def">{{item.def}}</view>
    </view>
  </view>
  <view class="empty" wx:else>没有找到「{{q}}」，换个词试试</view>
</block>

<!-- ② 场景命中：跨体系分类，把「这种场合会用到的语法」聚在一起 -->
<block wx:elif="{{tag}}">
  <view class="meta">「{{tag}}」场景下共 {{tagHits.length}} 个语法点</view>
  <view class="card" wx:if="{{tagHits.length}}">
    <view class="tp" wx:for="{{tagHits}}" wx:key="t" data-c="{{item.c}}" data-i="{{item.i}}"
          hover-class="tp--press" hover-stay-time="60" bindtap="onTopic">
      <view class="tp__head"><text class="tp__t">{{item.t}}</text><text class="tp__cat">{{item.catName}}</text><view class="tp__go"></view></view>
      <view class="tp__def">{{item.def}}</view>
    </view>
  </view>
</block>

<!-- ③ 体系分类目录（手风琴） -->
<block wx:else>
  <view class="intro">共 {{total}} 个语法点。两种找法：上面按「用在什么场合」筛，下面按 12 个体系分类翻。每个语法点含一句人话开场白、定义、用法、易错点、例句，能对应上课程的还会挂出「课程里讲过哪几天」。</view>

  <view class="card cat" wx:for="{{cats}}" wx:key="id" wx:for-item="C">
    <view class="cat__head" data-id="{{C.id}}" hover-class="cat__head--press" hover-stay-time="80" bindtap="onToggle">
      <view class="cat__l">
        <view class="cat__name">{{C.name}}</view>
        <view class="cat__intro">{{C.intro}}</view>
      </view>
      <view class="cat__n">{{C.topics.length}} 个</view>
      <view class="cat__arrow {{open === C.id ? 'on' : ''}}"></view>
    </view>
    <block wx:if="{{open === C.id}}">
      <view class="tp" wx:for="{{C.topics}}" wx:key="t" data-c="{{C.id}}" data-i="{{index}}"
            hover-class="tp--press" hover-stay-time="60" bindtap="onTopic">
        <view class="tp__head"><text class="tp__t">{{item.t}}</text><view class="tp__go"></view></view>
        <view class="tp__def">{{item.def}}</view>
      </view>
    </block>
  </view>
</block>

<view class="toast" wx:if="{{toast}}">{{toast}}</view>
</view>
