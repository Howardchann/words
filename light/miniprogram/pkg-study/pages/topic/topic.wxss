/* 语法点详情（分包页） */
/* 本页是普通页面（非 tab）：撤掉 app.wxss 给 tabBar 预留的底部内边距 */
page { padding-bottom: env(safe-area-inset-bottom); }

.head__cat { font-size: 22rpx; color: var(--uk-ink); background: var(--uk-bg);
  border-radius: 8rpx; padding: 2rpx 12rpx; align-self: flex-start; display: inline-block; }
.head__t { margin-top: 12rpx; font-size: 38rpx; font-weight: 800; color: var(--ink); line-height: 1.35; }
/* 人话开场白（v1.1.68）：零基础学习者先看这一句 ——「这东西帮你解决什么问题」，再往下才是术语式讲解 */
.head__plain { margin-top: 14rpx; padding: 14rpx 18rpx; border-radius: 12rpx; background: var(--soft);
  font-size: 26rpx; color: var(--ink3); line-height: 1.7; }
.head__def { margin-top: 12rpx; font-size: 27rpx; color: var(--ink3); line-height: 1.7; }

.li { display: flex; align-items: flex-start; margin-top: 14rpx; }
.li__dot { flex-shrink: 0; width: 12rpx; height: 12rpx; border-radius: 50%; background: var(--green);
  margin: 14rpx 14rpx 0 0; }
.li__tx { flex: 1; min-width: 0; font-size: 27rpx; color: var(--ink4); line-height: 1.75; word-break: break-word; }
.li--note .li__dot { background: var(--red); }
.li--note .li__tx { color: var(--ink3); }

.ex { display: flex; align-items: center; padding: 18rpx 16rpx; border-radius: 14rpx; border-bottom: 1rpx solid var(--line); }
.ex:last-child { border-bottom: none; }
.ex--press { background: var(--soft); }
.ex--on { background: var(--soft2); }
.ex__main { flex: 1; min-width: 0; }
.ex__en { font-size: 28rpx; color: var(--ink3); line-height: 1.7; word-break: break-word; }
.ex__cn { margin-top: 4rpx; font-size: 24rpx; color: var(--muted3); line-height: 1.6; }
.ex__spk { flex-shrink: 0; width: 40rpx; height: 40rpx; margin-left: 16rpx;
  background: center/contain no-repeat;
  background-image: url("data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%2024%2024'%3E%3Cpath%20d='M3%209v6h4l5%205V4L7%209H3z%20M16.5%2012c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73%202.5-2.25%202.5-4.02z%20M14%203.23v2.06c2.89.86%205%203.54%205%206.71s-2.11%205.85-5%206.71v2.06c4.01-.91%207-4.49%207-8.77s-2.99-7.86-7-8.77z'%20fill='%23176B5B'/%3E%3C/svg%3E"); }
.ex--on .ex__spk { background-image: url("data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%2024%2024'%3E%3Cpath%20d='M3%209v6h4l5%205V4L7%209H3z%20M16.5%2012c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73%202.5-2.25%202.5-4.02z%20M14%203.23v2.06c2.89.86%205%203.54%205%206.71s-2.11%205.85-5%206.71v2.06c4.01-.91%207-4.49%207-8.77s-2.99-7.86-7-8.77z'%20fill='%230E4C41'/%3E%3C/svg%3E"); }

/* 易错点：错例/对例对照（自绘 ✗/✓，不用系统 emoji ❌✅ —— 与全站线稿图标同一套观感）。
   对齐口径：.fix__row 走 align-items:baseline，图标盒与右侧首行文字同基线；
   图标盒定宽（34rpx）让「✗ / ✓」在左侧成一条竖线，与 .li__dot 的缩进感一致。 */
.fix { margin-top: 16rpx; }
.fix:first-child { margin-top: 4rpx; }
.fix__head { font-size: 24rpx; color: var(--muted3); line-height: 1.7; }
.fix__row { display: flex; align-items: baseline; margin-top: 6rpx; }
.fix__ico { flex-shrink: 0; width: 34rpx; text-align: center; font-size: 25rpx; font-weight: 700; }
.fix__ico--bad { color: var(--red); }
.fix__ico--good { color: var(--green); }
.fix__tx { flex: 1; min-width: 0; font-size: 27rpx; color: var(--ink3); line-height: 1.75; word-break: break-word; }
.fix__why { margin-top: 4rpx; padding-left: 44rpx; font-size: 23rpx; color: var(--muted2); line-height: 1.7; }

.day-chips { display: flex; flex-wrap: wrap; gap: 12rpx; }
.day-chip { background: var(--soft); color: var(--green); border-radius: 14rpx;
  padding: 12rpx 22rpx; font-size: 25rpx; font-weight: 700; }
.day-chip--press { background: var(--press-green); }
.note { margin-top: 16rpx; font-size: 23rpx; color: var(--muted2); line-height: 1.7; }

.toast { position: fixed; left: 50%; bottom: 180rpx; transform: translateX(-50%); z-index: 9999;
  background: var(--card); color: var(--ink); font-size: 26rpx; padding: 18rpx 34rpx; border-radius: 40rpx;
  box-shadow: 0 8rpx 30rpx rgba(0,0,0,.14); }

@media (min-width:700px) {
  .head__t { font-size: 19px; }
  .head__def { font-size: 14px; }
  .li__tx { font-size: 14px; }
  .ex__en { font-size: 14px; }
}
