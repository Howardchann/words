<page-meta page-style="{{pageStyle}}" />
<view class="page-root {{dark ? 'theme-dark' : ''}}">
<nav-bar title="搜索单词" back bind:back="onBack" />

<!-- 搜索条：与导航栏同底色，中间是白卡输入框 -->
<view class="search-bar">
  <view class="ico ico-search search-bar__ico"></view>
  <input class="search-bar__input" value="{{kw}}" focus="{{focus}}" confirm-type="search"
         hold-keyboard="{{true}}"
         placeholder="输入单词或中文释义" placeholder-class="search-bar__ph"
         bindinput="onInput" bindfocus="onFocus" bindblur="onBlur" bindconfirm="onConfirm" />
  <view class="search-bar__clear" wx:if="{{kw}}" hover-class="hover-dim" hover-stay-time="120" bindtap="onClear">×</view>
</view>

<!-- 空态：没输入关键词 -->
<view class="search-hint" wx:if="{{!kw}}">
  <view>全库共 <text class="search-hint__n">{{wordTotal}}</text> 个单词，输入英文或中文即可搜索。</view>
  <view class="search-hint__sub">只输入前几个字母也能搜到（如 nano → nanotechnology）。</view>
</view>

<block wx:if="{{kw}}">
  <!-- 结果计数 -->
  <view class="search-meta" wx:if="{{total > 0}}">找到 <text class="search-meta__n">{{total}}</text> 个结果{{more ? '，仅显示前 ' + list.length + ' 个' : ''}}</view>

  <!-- 结果列表：词行与今日页完全同构（单词/音标/词性/释义/例句/喇叭） -->
  <view class="card search-card" wx:if="{{list.length}}">
    <block wx:for="{{list}}" wx:key="w">
      <view class="word-row search-row" data-w="{{item.w}}" data-day="{{item.day}}" hover-class="search-row--press" hover-stay-time="60" bindtap="onJump">
        <view class="word-speak {{playingText === item.w ? 'playing' : ''}}"
              hover-class="speak-hover" hover-stay-time="120"
              data-text="{{item.w}}" data-ai="{{item.ai}}" data-kind="w" catchtap="onSpeakWord"><view class="spk-ico {{playingText === item.w ? 'spk-ico--on' : ''}}"></view></view>
        <view class="word-main">
          <view class="word-head"><text class="word-en"><text wx:if="{{playingText === item.w}}" class="kara-lit">{{karaLit}}</text>{{playingText === item.w ? karaRest : item.w}}</text><text class="word-ipa" wx:if="{{item.ipa}}">{{item.ipa}}</text><text class="word-pos">{{item.p}}</text></view>
          <view class="word-zh">{{item.m}}</view>
          <view class="word-example-row">
            <view class="word-example" data-text="{{item.e}}" data-ai="{{item.ai}}" data-kind="s" catchtap="onSpeakWord"><text wx:if="{{playingText === item.e}}" class="kara-lit">{{karaLit}}</text>{{playingText === item.e ? karaRest : item.e}}</view>
            <view class="ex-speak {{playingText === item.e ? 'playing' : ''}}"
                  hover-class="speak-hover" hover-stay-time="120"
                  data-text="{{item.e}}" data-ai="{{item.ai}}" data-kind="s" catchtap="onSpeakWord"><view class="spk-ico {{playingText === item.e ? 'spk-ico--on' : ''}}"></view></view>
          </view>
          <view class="search-day">Day {{item.day}} · 第{{item.wn}}周 {{item.dow}}<text class="search-day__go"> ›</text></view>
        </view>
      </view>
    </block>
  </view>

  <view class="search-tip" wx:if="{{list.length}}">点词条可跳到它所在的 Day 查看</view>

  <!-- 无结果 -->
  <view class="search-empty" wx:if="{{!list.length}}">
    <view class="empty-text">没有找到「{{kw}}」</view>
    <view class="search-empty__sub">英文支持模糊匹配（如 nano → nanotechnology），中文按释义检索（如「努力」）。换个关键词试试。</view>
  </view>
</block>

</view>
