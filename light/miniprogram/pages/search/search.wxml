<page-meta page-style="{{pageStyle}}" />
<view class="page-root {{dark ? 'theme-dark' : ''}}">
<nav-bar title="搜索单词" back bind:back="onBack" />

<!-- 搜索条：与导航栏同底色，中间是白卡输入框 -->
<view class="search-bar">
  <view class="ico ico-search search-bar__ico"></view>
  <input class="search-bar__input" value="{{kw}}" focus="{{focus}}" confirm-type="search"
         hold-keyboard="{{true}}"
         placeholder="输入单词或中文释义" placeholder-class="search-bar__ph"
         bindinput="onInput" bindfocus="onFocus" bindblur="onBlur" bindconfirm="onConfirm" />
  <view class="search-bar__clear" wx:if="{{kw}}" hover-class="hover-dim" hover-stay-time="120" bindtap="onClear">×</view>
</view>

<!-- 空态：没输入关键词 -->
<view class="search-hint" wx:if="{{!kw}}">
  <view>全库共 <text class="search-hint__n">{{wordTotal}}</text> 个单词，输入英文或中文即可搜索。</view>
  <view class="search-hint__sub">只输入前几个字母也能搜到（如 nano → nanotechnology）。</view>
</view>

<block wx:if="{{kw}}">
  <!-- 结果计数 -->
  <view class="search-meta" wx:if="{{total > 0}}">找到 <text class="search-meta__n">{{total}}</text> 个结果{{more ? '，仅显示前 ' + list.length + ' 个' : ''}}</view>

  <!-- 结果列表：词行与今日页完全同构（单词/音标/词性/释义/例句/喇叭） -->
  <view class="card search-card" wx:if="{{list.length}}">
    <block wx:for="{{list}}" wx:key="w">
      <!-- 点击归属（v1.1.49）：整张卡片 = 跳到该词所在的 Day；只有两个喇叭图标 catchtap 拦下做朗读。
           曾经例句文本也是 catchtap（点了朗读例句），但它 flex:1 撑满整行、还常折成两行，
           是卡片里面积最大的一块 —— 用户「点卡片」时经常落在它上面，表现就是「偶发点了不跳」。
           现在规则统一为：图标=朗读，其它任何位置=跳转。 -->
      <view class="word-row search-row" data-w="{{item.w}}" data-day="{{item.day}}"
            hover-class="search-row--press" hover-start-time="0" hover-stay-time="60" bindtap="onJump">
        <view class="word-main">
          <view class="word-head"><text class="word-en"><text wx:if="{{playingText === item.w}}" class="kara-lit">{{karaLit}}</text>{{playingText === item.w ? karaRest : item.w}}</text><text class="word-pos">{{item.p}}</text><view class="word-zh">{{item.m}}</view>
          <!-- 双音标模块（v1.1.51 方案A）。点击归属不变：模块是「朗读」，其余位置是「跳转」 -->
          <view class="ipa-row">
            <view class="ipa-mod {{playingText === item.w && playingAccent === 'us' ? 'on' : ''}}"
                  hover-class="speak-hover" hover-stay-time="120" hover-stop-propagation="{{true}}"
                  data-text="{{item.w}}" data-ai="{{item.ai}}" data-kind="w" data-accent="us" catchtap="onSpeakWord"><view class="spk-ico {{playingText === item.w && playingAccent === 'us' ? 'spk-ico--on' : ''}}"></view><text class="ipa-txt" wx:if="{{item.ipa}}">{{item.ipa}}</text></view>
            <view class="ipa-mod ipa-mod--uk {{playingText === item.w && playingAccent === 'uk' ? 'on' : ''}}"
                  wx:if="{{item.uk}}"
                  hover-class="speak-hover" hover-stay-time="120" hover-stop-propagation="{{true}}"
                  data-text="{{item.w}}" data-ai="{{item.ai}}" data-kind="w" data-accent="uk" catchtap="onSpeakWord"><view class="spk-ico {{playingText === item.w && playingAccent === 'uk' ? 'spk-ico--on' : ''}}"></view><text class="ipa-txt">{{item.uk}}</text></view>
          </view></view>
          <view class="word-example-row">
            <view class="word-example"><text wx:if="{{playingText === item.e}}" class="kara-lit">{{karaLit}}</text>{{playingText === item.e ? karaRest : item.e}}</view>
            <view class="ex-speak {{playingText === item.e ? 'playing' : ''}}"
                  hover-class="speak-hover" hover-stay-time="120" hover-stop-propagation="{{true}}"
                  data-text="{{item.e}}" data-ai="{{item.ai}}" data-kind="s" catchtap="onSpeakWord"><view class="spk-ico {{playingText === item.e ? 'spk-ico--on' : ''}}"></view></view>
          </view>
          <view class="search-day">第 {{item.day}} 天 · {{item.lvName}}<text class="search-day__go">{{jumpingW === item.w ? ' 跳转中…' : ' ›'}}</text></view>
        </view>
      </view>
    </block>
  </view>

  <view class="search-tip" wx:if="{{list.length}}">点卡片跳到它所在的 Day；点音标模块只朗读，不跳转</view>

  <!-- 无结果 -->
  <view class="search-empty" wx:if="{{!list.length}}">
    <view class="empty-text">没有找到「{{kw}}」</view>
    <view class="search-empty__sub">英文支持模糊匹配（如 nano → nanotechnology），中文按释义检索（如「努力」）。换个关键词试试。</view>
  </view>
</block>

</view>
