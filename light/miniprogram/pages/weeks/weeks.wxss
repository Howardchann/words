/* 开溜 · 学习等级页（v1.1.66 等级制：对外去「周」，按 4 个等级 + 天组织） */

/* 当前等级卡：大字等级名 + 本等级进度，全程进度弱化为小字 */
.cur-card{padding:30rpx 30rpx 26rpx}
.cur-head{display:flex;align-items:baseline;justify-content:space-between}
.cur-label{font-size:36rpx;font-weight:800;color:var(--ink)}
.cur-day{font-size:24rpx;color:var(--green);font-weight:700}
.cur-bar{height:14rpx;border-radius:7rpx;background:var(--line);margin-top:20rpx;overflow:hidden}
.cur-fill{height:100%;background:var(--green-solid);border-radius:7rpx}
.cur-meta{font-size:22rpx;color:var(--muted);margin-top:14rpx}

/* 等级磁贴 2×2：当前等级绿细描边，展开等级品牌绿描边 */
.level-grid{display:flex;flex-wrap:wrap;justify-content:space-between;margin:14rpx 24rpx}
/* 两块 49% 留 2% 取整余量：精确 100% 求和在真机小数 rpx 下会因亚像素取整挤成单列 */
.level-tile{width:49%;margin-bottom:14rpx;box-sizing:border-box;background:var(--card);border-radius:16rpx;padding:18rpx 20rpx;box-shadow:0 4rpx 18rpx rgba(23,107,91,.06);border:2rpx solid transparent}
.level-tile--cur{border-color:var(--cur-line);background:var(--cur-bg)}
.level-tile--open{border-color:var(--green)}
.tile-name{font-size:26rpx;font-weight:700;color:var(--ink)}
.tile-meta{font-size:20rpx;color:var(--muted);margin-top:4rpx}
.tile-bar{height:10rpx;border-radius:5rpx;background:var(--line);margin-top:12rpx;overflow:hidden}
.tile-fill{height:100%;background:var(--green-solid);border-radius:5rpx}
.tile-done{font-size:20rpx;color:var(--muted);margin-top:8rpx}

/* 展开的等级：连续日格，7 列；格子用内层做视觉留白（不依赖 flex gap / calc） */
.day-card{padding:24rpx 22rpx 20rpx}
.day-card-title{font-size:26rpx;font-weight:700;color:var(--ink);margin-bottom:16rpx}
.day-grid{display:flex;flex-wrap:wrap}
.day-cell{width:14.2857%;box-sizing:border-box;padding:4rpx}
.day-inner{height:72rpx;border-radius:10rpx;background:var(--bg);color:var(--muted);font-size:24rpx;display:flex;align-items:center;justify-content:center}
/* 第 6、7 天为复习日：虚线空底，与学习日形成视觉节奏 */
.day-inner--rest{background:transparent;border:2rpx dashed var(--line)}
/* 已打卡：浅绿实底 + 品牌绿字 */
.day-inner--done{background:var(--soft2);color:var(--green);font-weight:700}
.day-legend{font-size:20rpx;color:var(--muted);margin-top:16rpx}

/* 按压态：app.wxss 的 .hover-tint 同优先级但先加载，会被上面自身的 background 压过
   → 用双类选择器抬高优先级，按压色统一主题 --press-green / --press2（明暗两套齐备） */
.level-tile.hover-tint{background:var(--press-green)}
.day-inner.hover-tint{background:var(--press-green)}
.day-inner--done.hover-tint{background:var(--press2)}

/* iPad / 宽屏覆盖（纯追加，手机端不受影响），字号 = rpx × 0.5 */
@media (min-width:700px) {
  .cur-card { padding:15px 15px 13px; }
  .cur-label { font-size:18px; }
  .cur-day { font-size:12px; }
  .cur-bar { height:7px; border-radius:4px; margin-top:10px; }
  .cur-fill { border-radius:4px; }
  .cur-meta { font-size:11px; margin-top:7px; }
  .level-grid { max-width:640px; margin:7px auto; }
  .level-tile { width:49%; margin-bottom:7px; padding:9px 10px; border-radius:8px; }
  .tile-name { font-size:13px; }
  .tile-meta { font-size:10px; margin-top:2px; }
  .tile-bar { height:5px; border-radius:3px; margin-top:6px; }
  .tile-fill { border-radius:3px; }
  .tile-done { font-size:10px; margin-top:4px; }
  .day-card { padding:12px 11px 10px; }
  .day-card-title { font-size:13px; margin-bottom:8px; }
  .day-cell { padding:2px; }
  .day-inner { height:36px; border-radius:5px; font-size:12px; }
  .day-inner--rest { border-width:1px; }
  .day-legend { font-size:10px; margin-top:8px; }
}
