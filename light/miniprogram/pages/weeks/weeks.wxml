<page-meta page-style="{{pageStyle}}" />
<view class="page-root {{dark ? 'theme-dark' : ''}}">
<nav-bar title="{{navTitle}}" />
<!-- 学习等级总览（4 级 / 546 天 / 8000 词的进度地图） -->
<!-- 准备期横幅：计划未开始时解释为何进度全为 0 -->
<view class="card" wx:if="{{todayNum === 0}}">
  <view class="tip-box" style="margin-top:0;">
    <view class="tip-text">计划 {{startDateText}} 开始——还有 {{daysToStart}} 天开始学单词。进度从开始当天起累计，现在可以先浏览全表熟悉节奏</view>
  </view>
</view>

<!-- 当前等级卡：大字本等级进度，小字全程进度（弱化） -->
<view class="card cur-card">
  <view class="cur-head">
    <view class="cur-label">{{curLabel}}</view>
    <view class="cur-day">{{curDayText}}</view>
  </view>
  <view class="cur-bar"><view class="cur-fill" style="width:{{curPercent}}%"></view></view>
  <view class="cur-meta">本等级 {{curDone}}/{{curDays}} 天 · 全程 {{totalChecked}}/{{totalDays}} 天（{{totalPercent}}%）</view>
</view>

<!-- 四个等级磁贴（2×2）：点磁贴展开该等级的日格 -->
<view class="level-grid">
  <view class="level-tile {{openLevel === L.lv ? 'level-tile--open' : ''}} {{L.isCurrent ? 'level-tile--cur' : ''}} {{pressed === 'l' + L.lv ? 'hover-tint' : ''}}"
        wx:for="{{levels}}" wx:key="lv" wx:for-item="L"
        data-lv="{{L.lv}}" data-pk="l{{L.lv}}" bindtouchstart="onTileDown" bindtouchend="onTileUp" bindtouchcancel="onTileUp" bindtouchmove="onTileUp" bindtap="onLevelTap">
    <view class="tile-name">{{L.label}}</view>
    <view class="tile-meta">{{L.rangeText}} · {{L.words}} 词</view>
    <view class="tile-bar"><view class="tile-fill" style="width:{{L.percent}}%"></view></view>
    <view class="tile-done">{{L.doneCount}}/{{L.days}} 天</view>
  </view>
</view>

<!-- 展开的等级：连续日格（每 7 格一组，第 6、7 格为复习日） -->
<view class="card day-card" wx:if="{{openLevel}}">
  <view class="day-card-title">{{openTitle}}</view>
  <view class="day-grid">
    <view class="day-cell" wx:for="{{openDays}}" wx:key="d"
          data-d="{{item.d}}" data-pk="d{{item.d}}" bindtouchstart="onChipDown" bindtouchmove="onChipMove" bindtouchend="onChipEnd" bindtouchcancel="onChipCancel" catchtap="onDayTap">
      <view class="day-inner {{item.done ? 'day-inner--done' : ''}} {{item.rest && !item.done ? 'day-inner--rest' : ''}} {{pressed === 'd' + item.d ? 'hover-tint' : ''}}">{{item.d}}</view>
    </view>
  </view>
  <view class="day-legend">数字为全程第几天 · 虚线格为复习日</view>
</view>
</view>
