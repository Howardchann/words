/* 工具页（v1.1.67 · 原词表/计划页改造）
   四块：学习记录 / 查单词 / 音标 / 语法速查。
   词行、喇叭、歌词高亮、卡片等一律复用全局 app.wxss，这里只写本页特有的部分。 */

/* ① 学习记录 */
.rec-card { padding: 30rpx 28rpx 22rpx; }
.rec-row { display: flex; align-items: center; }
.rec-item { flex: 1; text-align: center; }
.rec-div { width: 1rpx; height: 68rpx; background: var(--line); }
/* 三格数字统一绿色（与「设置」页 .stat-num 同一口径）；单位跟着数字走，不再另起一色 */
.rec-num { font-size: 56rpx; line-height: 1.1; font-weight: 800; color: var(--green); font-variant-numeric: tabular-nums; }
.rec-unit { font-size: 24rpx; font-weight: 600; margin-left: 6rpx; }
.rec-label { margin-top: 6rpx; font-size: 24rpx; color: var(--muted); }

/* ② 查单词 */
.search-card { padding: 24rpx 28rpx; }
.tk-bar { display: flex; align-items: center; padding: 0 22rpx; height: 76rpx;
  background: var(--soft); border-radius: 38rpx; }
.tk-bar__ico { flex-shrink: 0; width: 32rpx; height: 32rpx; margin-right: 14rpx; }
.tk-bar__input { flex: 1; min-width: 0; height: 76rpx; font-size: 28rpx; color: var(--ink); }
.tk-bar__ph { color: var(--muted); font-size: 28rpx; }
.tk-bar__clear { flex-shrink: 0; width: 48rpx; height: 48rpx; line-height: 46rpx; text-align: center;
  font-size: 38rpx; color: var(--muted); border-radius: 50%; }
.tk-hint { margin-top: 16rpx; font-size: 25rpx; color: var(--muted3); line-height: 1.7; }
.tk-hint__n { color: var(--green); font-weight: 700; }
.tk-meta { margin-top: 16rpx; font-size: 25rpx; color: var(--muted3); }
.tk-meta__n { color: var(--green); font-weight: 700; }
.tk-row { border-radius: 14rpx; }
.tk-row--press { background: var(--soft); }
.tk-day { font-size: 22rpx; color: var(--green); margin-top: 10rpx; }
.tk-day__go { color: var(--muted); }
.tk-empty { text-align: center; padding: 40rpx 24rpx 24rpx; }
.tk-empty__sub { margin-top: 14rpx; font-size: 24rpx; color: var(--muted); line-height: 1.7; }
.tk-note { margin-top: 16rpx; font-size: 23rpx; color: var(--muted2); line-height: 1.7; }

/* ④ 语法速查（分类卡） */
.cat-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; }
.cat-cell { background: var(--soft); border-radius: 16rpx; padding: 20rpx 22rpx;
  display: flex; align-items: center; justify-content: space-between; }
.cat-cell--press { background: var(--press-green); }
.cat-name { font-size: 27rpx; font-weight: 700; color: var(--ink); }
.cat-count { font-size: 22rpx; color: var(--green); }

/* ③ 音标（大类 + 子类两级筛选 → 音标网格 → 常驻详情面板） */
.ph-hint { margin: 8rpx 0 14rpx; font-size: 23rpx; color: var(--muted2); line-height: 1.7; }

/* 大类切换（元音 / 辅音）：两个等宽段控 */
.ph-class { display: flex; gap: 14rpx; }
.ph-cls { flex: 1; text-align: center; height: 68rpx; line-height: 68rpx; border-radius: 14rpx;
  background: var(--soft); font-size: 28rpx; font-weight: 700; color: var(--muted3); }
.ph-cls.on { background: var(--green); color: #FFFFFF; }
.ph-cls--press { opacity: .85; }
.ph-cls__n { font-size: 22rpx; font-weight: 600; margin-left: 8rpx; opacity: .8; }

/* 子类筛选（全部 / 短元音 …）：胶囊 chips，自动换行 */
.ph-sub { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 14rpx; }
.ph-subchip { padding: 8rpx 20rpx; border-radius: 24rpx; font-size: 24rpx;
  background: var(--soft); color: var(--muted3); }
.ph-subchip.on { background: var(--soft2); color: var(--green); font-weight: 700; }
.ph-subchip--press { opacity: .8; }

.ph-grid { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 16rpx; }
.ph-chip { min-width: 96rpx; padding: 12rpx 16rpx; box-sizing: border-box; text-align: center;
  background: var(--soft); border-radius: 14rpx; font-size: 28rpx; font-weight: 700; color: var(--green);
  font-family: 'Times New Roman', Georgia, serif; }
.ph-chip--press { background: var(--press-green); }
/* 选中态：绿底白字（两个类选择器，优先级高于单类的 --press，按压时不会掉色） */
.ph-chip.on { background: var(--green); color: #FFFFFF; }
.ph-chip.on.ph-chip--press { opacity: .88; }

/* 常驻详情面板：紧跟网格下方（不再排到 2 屏之外），位置随筛选结果自动上移 */
.ph-panel { margin-top: 24rpx; padding: 22rpx 26rpx 18rpx; border-radius: 16rpx;
  background: var(--soft); border: 1rpx solid var(--line); }
.ph-head { display: flex; align-items: baseline; }
.ph-big { font-size: 56rpx; font-weight: 800; color: var(--green); line-height: 1.15;
  font-family: 'Times New Roman', Georgia, serif; }
.ph-tag { margin-left: 16rpx; font-size: 23rpx; color: var(--muted); }
.ph-block { margin-top: 20rpx; }
.ph-block__t { font-size: 24rpx; font-weight: 700; color: var(--green); margin-bottom: 8rpx; letter-spacing: 1rpx; }
.ph-block__b { font-size: 27rpx; color: var(--ink4); line-height: 1.75; }

/* 例词行（v1.1.69 方案A「左列喇叭」）：喇叭在行首成一列，文字左对齐、自然宽度。
   —— 原方案是「文字 flex:1 撑满 + 喇叭钉最右」，但例词很短（sit·i·坐），撑满后中间空出
      行宽 49%~72% 的空白（用户真机反馈）。喇叭前移后，右侧不再有元素把空白"框"出来，
      末尾留白变成看不见的自然行尾空白，三行文字与三枚喇叭各成一条竖线，长短词都不跳版。
   ⚠️ 垂直对齐仍走全站铁律：.ex-speak 的零宽空格 strut + .spk-ico vertical-align:middle
      （x-height 锚定），对 .ph-ex 的 align-items:baseline 生效；绝不自建 flex 居中盒。 */
.ph-ex { display: flex; align-items: baseline; padding: 16rpx 14rpx; border-bottom: 1rpx solid var(--line); }
.ph-ex:last-child { border-bottom: none; }
.ph-ex--press { background: var(--card); border-radius: 14rpx; }
/* 行首喇叭：取消 margin-left，盒宽收到 44rpx（图标仍是 36rpx 定值不变，只少一点左侧缩进） */
.ex-speak--lead { margin-left: 0; margin-right: 14rpx; width: 44rpx; height: 44rpx; }
.ph-ex__txt { flex: 1; min-width: 0; }
.ph-ex__w { font-size: 29rpx; font-weight: 700; color: var(--ink); }
/* 目标字母就地染色（v1.1.70）：取代原来的独立蓝色小标签（`sit i 坐`）。
   直接让「发这个音的那几个字母」在单词内部变色，一眼就能对上「哪个字母发哪个音」。
   ⚠️ 光靠颜色不够：--green(#176B5B) 对正文深灰(#24332F) 的对比度实测只有约 2:1，
   29rpx 小字下肉眼几乎分不出（无头浏览器同字号 4 档对比验证过）→ 补一条 3rpx 同色底线
   （border-bottom + currentColor，线随字色），不引新色值、深浅主题自动跟随（--green 两态都可用）。
   不用 text-decoration-thickness/offset：iOS WKWebView 对这两个属性支持不全，border-bottom 全兼容。 */
.ph-ex__seg--hit { color: var(--green); border-bottom: 3rpx solid currentColor; padding-bottom: 2rpx; }
.ph-ex__cn { font-size: 24rpx; color: var(--muted3); margin-left: 14rpx; }

/* iPad / 宽屏覆盖（纯追加，手机端不受影响），尺寸 = rpx × 0.5 */
@media (min-width:700px) {
  .rec-card { padding: 15px 14px 11px; }
  .rec-num { font-size: 28px; }
  .rec-div { height: 34px; }
  .tk-bar { height: 38px; border-radius: 19px; padding: 0 11px; }
  .tk-bar__input { height: 38px; }
  .cat-grid { gap: 7px; }
  .cat-cell { padding: 10px 11px; border-radius: 8px; }
  .ph-chip { min-width: 48px; padding: 6px 8px; font-size: 14px; }
  .ph-cls { height: 34px; line-height: 34px; border-radius: 7px; font-size: 14px; }
  .ph-subchip { padding: 4px 10px; border-radius: 12px; font-size: 12px; }
  .ph-panel { margin-top: 12px; padding: 11px 13px 9px; border-radius: 8px; }
  .ph-big { font-size: 28px; }
  /* 行首喇叭（v1.1.69）：尺寸 = rpx × 0.5，必须显式 px 化，否则 44rpx 在 700px+ 窗口被放大 3 倍 */
  .ex-speak--lead { margin-left: 0; margin-right: 7px; width: 22px; height: 22px; }
}
