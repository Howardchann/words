<page-meta page-style="{{pageStyle}}" />
<view class="page-root {{dark ? 'theme-dark' : ''}}">
<nav-bar title="{{navTitle}}" />

<!-- ① 学习记录：三格。已学天数分母 = 可打卡天数（弹性日不占名额，口径写在设置-关于） -->
<view class="card rec-card">
  <view class="rec-row">
    <view class="rec-item">
      <view class="rec-num">{{learnedDays}}<text class="rec-unit">天</text></view>
      <view class="rec-label">已学</view>
    </view>
    <view class="rec-div"></view>
    <view class="rec-item">
      <view class="rec-num">{{learnedWords}}<text class="rec-unit">个</text></view>
      <view class="rec-label">已学单词</view>
    </view>
    <view class="rec-div"></view>
    <view class="rec-item">
      <view class="rec-num">{{leftDays}}<text class="rec-unit">天</text></view>
      <view class="rec-label">预计还剩</view>
    </view>
  </view>
</view>

<!-- ② 查单词 -->
<view class="card search-card">
  <view class="section-label">查单词</view>
  <view class="tk-bar">
    <view class="ico ico-search tk-bar__ico"></view>
    <input class="tk-bar__input" value="{{kw}}" focus="{{focus}}" confirm-type="search"
           hold-keyboard="{{true}}"
           placeholder="输入单词或中文释义" placeholder-class="tk-bar__ph"
           bindinput="onInput" bindfocus="onFocus" bindblur="onBlur" bindconfirm="onConfirm" />
    <view class="tk-bar__clear" wx:if="{{kw}}" hover-class="hover-dim" hover-stay-time="120" bindtap="onClear">×</view>
  </view>

  <view class="tk-hint" wx:if="{{!kw}}">全库共 <text class="tk-hint__n">{{wordTotal}}</text> 个单词；只输入前几个字母也能搜到（如 nano → nanotechnology）。</view>
  <view class="tk-meta" wx:if="{{kw && total > 0}}">找到 <text class="tk-meta__n">{{total}}</text> 个结果{{more ? '，仅显示前 ' + list.length + ' 个' : ''}}</view>

  <!-- 结果行与今日页词行同构：图标 = 朗读，其它位置 = 跳到该词所在的 Day -->
  <block wx:for="{{list}}" wx:key="w">
    <view class="word-row tk-row" data-w="{{item.w}}" data-day="{{item.day}}"
          hover-class="tk-row--press" hover-start-time="0" hover-stay-time="60" bindtap="onJump">
      <view class="word-main">
        <view class="word-head"><text class="word-en"><text wx:if="{{playingText === item.w}}" class="kara-lit">{{karaLit}}</text>{{playingText === item.w ? karaRest : item.w}}</text><text class="word-pos">{{item.p}}</text><view class="word-zh">{{item.m}}</view>
          <view class="ipa-row">
            <view class="ipa-mod {{playingText === item.w && playingAccent === 'us' ? 'on' : ''}}"
                  hover-class="speak-hover" hover-stay-time="120" hover-stop-propagation="{{true}}"
                  data-text="{{item.w}}" data-ai="{{item.ai}}" data-kind="w" data-accent="us" catchtap="onSpeak"><view class="spk-ico {{playingText === item.w && playingAccent === 'us' ? 'spk-ico--on' : ''}}"></view><text class="ipa-txt" wx:if="{{item.ipa}}">{{item.ipa}}</text></view>
            <view class="ipa-mod ipa-mod--uk {{playingText === item.w && playingAccent === 'uk' ? 'on' : ''}}"
                  wx:if="{{item.uk}}"
                  hover-class="speak-hover" hover-stay-time="120" hover-stop-propagation="{{true}}"
                  data-text="{{item.w}}" data-ai="{{item.ai}}" data-kind="w" data-accent="uk" catchtap="onSpeak"><view class="spk-ico {{playingText === item.w && playingAccent === 'uk' ? 'spk-ico--on' : ''}}"></view><text class="ipa-txt">{{item.uk}}</text></view>
          </view></view>
        <view class="word-example-row">
          <view class="word-example"><text wx:if="{{playingText === item.e}}" class="kara-lit">{{karaLit}}</text>{{playingText === item.e ? karaRest : item.e}}</view>
          <view class="ex-speak {{playingText === item.e ? 'playing' : ''}}"
                hover-class="speak-hover" hover-stay-time="120" hover-stop-propagation="{{true}}"
                data-text="{{item.e}}" data-ai="{{item.ai}}" data-kind="s" catchtap="onSpeak"><view class="spk-ico {{playingText === item.e ? 'spk-ico--on' : ''}}"></view></view>
        </view>
        <view class="tk-day">第 {{item.day}} 天<text class="tk-day__go">{{jumpingW === item.w ? ' 跳转中…' : ' ›'}}</text></view>
      </view>
    </view>
  </block>

  <view class="tk-empty" wx:if="{{kw && !list.length}}">
    <view class="empty-text">没有找到「{{kw}}」</view>
    <view class="tk-empty__sub">英文支持模糊匹配，中文按释义检索。换个关键词试试。</view>
  </view>
</view>

<!-- ③ 音标（常驻面板：上面点音标，下方详情固定在原位；无弹层、无遮罩） -->
<view class="card">
  <view class="section-label">音标（{{phonTotal}} 个）</view>
  <view class="ph-title">元音</view>
  <block wx:for="{{vowelGroups}}" wx:key="name" wx:for-item="G">
    <view class="ph-grp">{{G.name}}</view>
    <view class="ph-grid">
      <view class="ph-chip {{ph.s === item.s ? 'on' : ''}}" wx:for="{{G.items}}" wx:key="s" data-s="{{item.s}}"
            hover-class="ph-chip--press" hover-stay-time="80" bindtap="onPhonTap">/{{item.s}}/</view>
    </view>
  </block>
  <view class="ph-title ph-title--gap">辅音</view>
  <block wx:for="{{consGroups}}" wx:key="name" wx:for-item="G">
    <view class="ph-grp">{{G.name}}</view>
    <view class="ph-grid">
      <view class="ph-chip {{ph.s === item.s ? 'on' : ''}}" wx:for="{{G.items}}" wx:key="s" data-s="{{item.s}}"
            hover-class="ph-chip--press" hover-stay-time="80" bindtap="onPhonTap">/{{item.s}}/</view>
    </view>
  </block>

  <view class="ph-panel" wx:if="{{ph}}">
    <view class="ph-head">
      <view class="ph-big">/{{ph.s}}/</view>
      <view class="ph-tag">{{ph.grp}}</view>
    </view>
    <view class="ph-block">
      <view class="ph-block__t">怎么读</view>
      <view class="ph-block__b">{{ph.tips}}</view>
    </view>
    <view class="ph-block">
      <view class="ph-block__t">易混音</view>
      <view class="ph-block__b">{{ph.mix}}</view>
    </view>
    <view class="ph-block">
      <view class="ph-block__t">例词</view>
      <view class="ph-ex" wx:for="{{ph.ex}}" wx:key="w" data-w="{{item.w}}"
            hover-class="tk-row--press" hover-stay-time="80" bindtap="onSpeakPhonEx">
        <view class="spk-ico {{playingText === item.w ? 'spk-ico--on' : ''}}"></view>
        <text class="ph-ex__w">{{item.w}}</text>
        <text class="ph-ex__hit">{{item.hit}}</text>
        <text class="ph-ex__cn">{{item.cn}}</text>
      </view>
    </view>
  </view>
  <view class="tk-note">点任意音标，下面的讲解随即切换；例词可直接点读（词表里有的词离线也能听）。</view>
</view>

<!-- ④ 语法速查：本页只给目录（全文在分包，避免撑大启动包） -->
<view class="card">
  <view class="section-label">语法速查</view>
  <view class="cat-grid">
    <view class="cat-cell" wx:for="{{cats}}" wx:key="id" data-id="{{item.id}}"
          hover-class="cat-cell--press" hover-stay-time="80" bindtap="onCatTap">
      <view class="cat-name">{{item.name}}</view>
      <view class="cat-count">{{item.count}} 个</view>
    </view>
  </view>
  <view class="tk-note">共 {{catTotal}} 个语法点：一句话定义 + 用法 + 易错点 + 例句，能对应上课程的还会挂出「课程里讲过哪几天」。点分类进入。</view>
</view>

<feedback id="fb"/>
</view>
