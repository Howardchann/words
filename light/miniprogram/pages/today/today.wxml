<page-meta page-style="{{pageStyle}}" />
<view class="page-root {{dark ? 'theme-dark' : ''}}">
<nav-bar title="{{navTitle}}"><view class="nav-search" hover-class="nav-search--press" hover-stay-time="120" bindtap="goSearch" aria-role="button" aria-label="搜索单词"><view class="ico ico-search"></view></view></nav-bar>
<!-- 今日学习计划 -->
<!-- 准备期：计划尚未开始 -->
<view class="card prestart-card" wx:if="{{preStart}}">
  <view class="prestart-title">准备期</view>
  <view class="prestart-sub">先熟悉一下，随时可以开始</view>
  <view class="prestart-days" wx:if="{{daysToStart > 0}}">还有 {{daysToStart}} 天开始学单词</view>
  <view class="prestart-note" wx:else>还没有学习记录 · 点「开始学习」即开学</view>
  <view class="tip-box">
    <view class="tip-text">可以先看看第 1 天的单词，熟悉一下操作：点音标模块听发音（美音 / 英音各读各的），点<view class="ico-inline ico-heart"></view>收藏重点词</view>
  </view>
  <!-- 单主按钮 + 文字链接（v1.1.92 方案④，用户在方案报告里选定）：
       主 = 实心绿大按钮「开始学习」（--green-solid 底 + 白字，全站首个实心主按钮）；
       次 = 其下一行绿字链接「先看看第 1 天（只预览）」，降级为文字、不再是等重的一行。
       行为完全不变：startLearning（写 startDate=今天，回第 1 天）/ backToToday（只预览不打卡）。 -->
  <view class="prestart-start" hover-class="prestart-start--press" hover-stay-time="120" bindtap="startLearning" aria-role="button" aria-label="开始学习，从第 1 天开始">
    <view class="prestart-start__tt">开始学习</view>
    <view class="prestart-start__go"></view>
  </view>
  <view class="prestart-preview" hover-class="prestart-preview--press" hover-stay-time="120" bindtap="backToToday" aria-role="button" aria-label="先看看第 1 天，只预览不打卡">
    <view class="prestart-preview__tt">先看看第 1 天（只预览）</view>
    <view class="prestart-preview__go"></view>
  </view>
</view>

<block wx:else>
<!-- 准备期预览提示条：替代原「回到准备期」纯文字链接，常驻顶部一眼可见 -->
<view class="prep-back" wx:if="{{todayNum === 0}}" hover-class="hover-dim" hover-stay-time="120" bindtap="backToPrep">‹ 返回准备期</view>

  <!-- 日期导航 -->
  <view class="card day-head">
    <view class="day-nav">
      <view class="nav-btn {{viewDay > 1 ? '' : 'nav-btn--dis'}}" hover-class="{{viewDay > 1 ? 'nav-btn--press' : 'none'}}" hover-stay-time="120" bindtap="prevDay">‹ 前一天</view>
      <view class="day-title">
        <view class="day-num">第 {{dayNum}} 天</view>
        <view class="day-dow">{{dowText}}</view>
      </view>
      <view class="nav-btn {{viewDay < totalDays ? '' : 'nav-btn--dis'}}" hover-class="{{viewDay < totalDays ? 'nav-btn--press' : 'none'}}" hover-stay-time="120" bindtap="nextDay">后一天 ›</view>
    </view>
    <view class="phase-line">{{theme}}</view>
    <!-- v1.1.97：「回到今天」按自然日算 → 改为「回到当前进度」= curDay（第一个未完成日）。
         目标日由 today.js 的 backToProgress() 提供，页面不再跟自然日滚动。 -->
    <view class="is-today" wx:if="{{dayNum !== curDay && curDay > 0}}" hover-class="hover-dim" hover-stay-time="120" bindtap="backToProgress">回到当前进度（第 {{curDay}} 天）</view>
  </view>

  <!-- 标题与目标 -->
  <view class="card">
    <view class="section-label">{{dayData.t}}</view>
    <view class="obj-text" wx:if="{{dayData.obj}}">目标：{{dayData.obj}}</view>
    <view class="time-text" wx:if="{{dayData.time}}">建议时长：{{dayData.time}}</view>

    <!-- 打卡 -->
    <view class="checkin-btn" wx:if="{{dayData.type !== 'sat'}}">
      <button class="btn-primary btn-fit {{todayNum === 0 ? 'btn-primary--dis' : ''}}" wx:if="{{!checked}}" hover-class="btn-press" hover-stay-time="0" bindtap="onCheckin">完成打卡<view class="ico ico-check" style="margin-left:var(--ico-gap);margin-right:0"></view></button>
      <view class="done-state" wx:else>今日已完成<view class="ico ico-check" style="margin-left:var(--ico-gap);margin-right:0"></view></view>
      <button class="btn-ghost btn-cancel btn-fit" wx:if="{{checked}}" hover-class="btn-press" hover-stay-time="0" bindtap="onCheckin"><view class="ico ico-undo"></view>取消打卡</button>
    </view>
  </view>

  <!-- 学习日：词汇 -->
  <view class="card" wx:if="{{dayData.type === 'study'}}">
    <view class="section-label">本日词汇（{{vocab.length}}）</view>
    <view class="speak-all-row">
      <button class="btn-ghost btn-speak-all {{playingMode === 'queue' ? 'btn-speak-all--active' : ''}}" hover-class="btn-press" bindtap="onSpeakAll"><view class="ico {{playingMode === 'queue' ? 'ico-stop' : 'ico-play'}}"></view>{{playingMode === 'queue' ? '停止朗读' : '朗读全部'}}</button>
    </view>
    <block wx:for="{{vocab}}" wx:key="w">
      <view class="group-tag" wx:if="{{index === 0 && coreCount > 0}}">主题词 · {{coreCount}}</view>
      <view class="group-tag group-tag--extra" wx:if="{{index === extraStart}}">扩展词 · {{extraCount}}</view>
      <view class="word-row{{hlWord === item.w ? ' word-row--hl' : ''}}" id="w{{index}}">
      <view class="word-main">
        <view class="word-head"><text class="word-en"><text wx:if="{{playingText === item.w}}" class="kara-lit">{{karaLit}}</text>{{playingText === item.w ? karaRest : item.w}}</text><text class="word-pos">{{item.p}}</text><view class="word-zh">{{item.m}}</view>
        <!-- 双音标模块（v1.1.51 方案A）：美音绿系 / 英音蓝系，各带小喇叭，点模块即按该口音朗读。
             无音标的短语仍渲染美音模块（只有喇叭）以保留朗读入口。 -->
        <view class="ipa-row">
          <view class="ipa-mod {{playingText === item.w && playingAccent === 'us' ? 'on' : ''}}"
                hover-class="speak-hover" hover-stay-time="120"
                data-text="{{item.w}}" data-ai="{{item.ai}}" data-kind="w" data-accent="us" bindtap="onSpeakWord"><view class="spk-ico {{playingText === item.w && playingAccent === 'us' ? 'spk-ico--on' : ''}}"></view><text class="ipa-txt" wx:if="{{item.ipa}}">{{item.ipa}}</text></view>
          <view class="ipa-mod ipa-mod--uk {{playingText === item.w && playingAccent === 'uk' ? 'on' : ''}}"
                wx:if="{{item.uk}}"
                hover-class="speak-hover" hover-stay-time="120"
                data-text="{{item.w}}" data-ai="{{item.ai}}" data-kind="w" data-accent="uk" bindtap="onSpeakWord"><view class="spk-ico {{playingText === item.w && playingAccent === 'uk' ? 'spk-ico--on' : ''}}"></view><text class="ipa-txt">{{item.uk}}</text></view>
        </view></view>
        <!-- 其他词形（v1.1.77）：固定常驻（不再只跟 2s 跳转高亮），点词形即朗读该形式 -->
        <view class="wf-line" wx:if="{{item.wf.length}}">
          <view class="wf-line__t {{wfKey === item.w + ':' + F.form ? 'wf-line__t--on' : ''}}" wx:for="{{item.wf}}" wx:for-item="F" wx:key="form"
                hover-class="none" hover-stay-time="0"
                data-text="{{F.form}}" data-key="{{item.w}}:{{F.form}}" catchtap="onSpeakWfToday">{{F.label}} {{F.form}}</view>
        </view>
        <!-- 变体标注（v1.1.75）：搜索结果卡上的「『took』是它的过去式」随跳转带到定位行下，
             与高亮同生共死（2s 自动清空），用户不会忘了自己查的是哪种形式 -->
        <view class="hl-via" wx:if="{{hlWord === item.w && hlVia}}">「{{hlQ}}」是它的{{hlVia}}</view>
        <view class="word-example-row">
          <view class="word-example"
                data-text="{{item.e}}" data-ai="{{item.ai}}" data-kind="s" bindtap="onSpeakWord"><text wx:if="{{playingText === item.e}}" class="kara-lit">{{karaLit}}</text>{{playingText === item.e ? karaRest : item.e}}</view>
          <view class="ex-speak {{playingText === item.e ? 'playing' : ''}}"
                hover-class="speak-hover" hover-stay-time="120"
                data-text="{{item.e}}" data-ai="{{item.ai}}" data-kind="s" bindtap="onSpeakWord"><view class="spk-ico {{playingText === item.e ? 'spk-ico--on' : ''}}"></view></view>
          <view class="ex-eye" wx:if="{{item.cn}}" hover-class="none" hover-stay-time="120" data-w="{{item.w}}" catchtap="onToggleExZh"><view class="eye-ico {{zhOpen[item.w] ? 'eye-ico--on' : ''}}"></view></view>
        </view>
        <view class="ex-cn" wx:if="{{item.cn && zhOpen[item.w]}}">{{item.cn}}</view>
      </view>
      <view class="word-star {{item.starred ? 'on' : ''}}" data-index="{{index}}" hover-class="hover-dim" hover-stay-time="120" bindtap="onStar"><view class="star-ico {{item.starred ? 'star-ico--on' : 'star-ico--off'}}"></view></view>
      </view>
    </block>
  </view>

  <!-- 学习日：例句精读（语法内容保留，仅换标题口径） -->
  <view class="card" wx:if="{{dayData.type === 'study' && dayData.g}}">
    <view class="section-label">{{dayData.g.label || '例句精读'}} · {{dayData.g.t}}</view>
    <view class="grammar-exp">{{dayData.g.exp}}</view>
    <!-- 例句精读（v1.1.85）：每条 = {v 显示原文, spk 是否有可朗读的英文}。
         含汉字的句子（「每天 5 分钟回忆，胜过 20 分钟抄写。」）不渲染喇叭 —— 此前它们带喇叭，
         点下去是在线 TTS 读中文（与全站 Azure 音色完全两回事）。
         v1.1.91：方法日（g.plain）无序号、样式降格为左侧细竖线的浅色补充条 —— 这些中文要点与上方
         背景色注释区是同一件事的两种说法，并列编号会显得重复。point 日（有英文例句）保持编号列表。 -->
    <view class="grammar-ex {{dayData.g.plain ? 'grammar-ex--sup' : ''}}" wx:for="{{dayData.g.ex}}" wx:key="v">
      <view class="ex-no" wx:if="{{!dayData.g.plain}}">{{index + 1}}.</view>
      <text class="grammar-ex-text"><text wx:if="{{playingText === item.v}}" class="kara-lit">{{karaLit}}</text>{{playingText === item.v ? karaRest : item.v}}</text>
      <view class="ex-speak {{playingText === item.v ? 'playing' : ''}}" wx:if="{{item.spk}}"
            hover-class="speak-hover" hover-stay-time="120"
            data-text="{{item.v}}" data-kind="g" bindtap="onSpeakWord"><view class="spk-ico {{playingText === item.v ? 'spk-ico--on' : ''}}"></view></view>
    </view>
  </view>

  <!-- 弹性日/收尾日不再单独渲染卡片：标题与目标卡已显示 dayData.t + obj，
       旧版这里再渲染一次「弹性复习日/收尾自检 + 同一段 obj」，造成整段文字重复 -->

  <!-- 练习任务 -->
  <view class="card" wx:if="{{dayData.pr}}">
    <view class="section-label">{{dayData.type === 'sun' ? '自检任务' : (dayData.type === 'sat' ? '今日可选任务' : '练习任务')}}</view>
    <view class="practice-line" wx:for="{{prLines}}" wx:key="no"><text class="prac-no">{{item.no}}.</text><text>{{item.text}}</text></view>
  </view>

  <!-- 学习提示 -->
  <view class="card tip-box" wx:if="{{dayData.tip}}">
    <view class="section-label">学习提示</view>
    <view class="tip-text">{{dayData.tip}}</view>
  </view>
</block>

<feedback id="fb"/>
</view>
