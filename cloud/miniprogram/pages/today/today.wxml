<page-meta page-style="{{pageStyle}}" />
<view class="page-root {{dark ? 'theme-dark' : ''}}">
<nav-bar title="{{navTitle}}"><view class="nav-search" hover-class="nav-search--press" hover-stay-time="120" bindtap="goSearch" aria-role="button" aria-label="搜索单词"><view class="ico ico-search"></view></view></nav-bar>

<!-- 准备期：计划尚未开始 -->
<view class="card prestart-card" wx:if="{{preStart}}">
  <view class="prestart-title">准备期</view>
  <view class="prestart-sub">先熟悉一下，随时可以开始</view>
  <view class="prestart-note">还没有学习记录 · 点「开始学习」即从第 1 册第 1 章第 1 节开始</view>
  <view class="tip-box">
    <view class="tip-text">可以先看看第 1 节的单词，熟悉一下操作：点音标模块听发音（美音 / 英音各读各的），点<view class="ico-inline ico-heart"></view>收藏重点词</view>
  </view>
  <view class="prestart-start" hover-class="prestart-start--press" hover-stay-time="120" bindtap="startLearning" aria-role="button" aria-label="开始学习，从第 1 节开始">
    <view class="prestart-start__tt">开始学习</view>
    <view class="prestart-start__go"></view>
  </view>
  <view class="prestart-preview" hover-class="prestart-preview--press" hover-stay-time="120" bindtap="backToToday" aria-role="button" aria-label="先看看第 1 节，只预览不打卡">
    <view class="prestart-preview__tt">先看看第 1 节（只预览）</view>
    <view class="prestart-preview__go"></view>
  </view>
</view>

<block wx:else>
<!-- 准备期预览提示条 -->
<view class="prep-back" wx:if="{{prepPreview && !preStart}}" hover-class="hover-dim" hover-stay-time="120" bindtap="backToPrep">‹ 返回准备期</view>

<!-- ① 目录（v1.1.110）：册 → 章 → 节 三级；只展开一册一章 -->
<view class="card dir-card">
  <view class="dir-head" hover-class="dir-head--press" hover-stay-time="80" bindtap="onDirToggle">
    <view class="dir-head__l">
      <view class="dir-loc">{{locText}}</view>
      <view class="dir-cur">{{sectionTitle}}</view>
    </view>
    <view class="dir-btn">{{dirOpen ? '收起' : '目录'}}</view>
  </view>
  <block wx:if="{{dirOpen}}">
    <view class="dir-book" wx:for="{{dirBooks}}" wx:for-item="B" wx:key="book">
      <view class="dir-book__h {{B.open ? 'on' : ''}}" data-book="{{B.book}}" hover-class="dir-row--press" hover-stay-time="60" bindtap="onDirBook">
        <text class="dir-book__t">{{B.title}}</text>
        <text class="dir-book__n">{{B.done}} / {{B.total}}</text>
        <view class="dir-caret {{B.open ? 'on' : ''}}"></view>
      </view>
      <block wx:if="{{B.open}}">
        <view class="dir-ch" wx:for="{{B.chapters}}" wx:for-item="C" wx:key="ch">
          <view class="dir-ch__h {{C.open ? 'on' : ''}}" data-ch="{{C.ch}}" hover-class="dir-row--press" hover-stay-time="60" bindtap="onDirCh">
            <text class="dir-ch__no">{{C.chInBook}}</text>
            <text class="dir-ch__t">{{C.title}}</text>
            <text class="dir-ch__n">{{C.done}} / {{C.total}}</text>
            <view class="dir-caret {{C.open ? 'on' : ''}}"></view>
          </view>
          <view class="dir-secs" wx:if="{{C.open}}">
            <view class="dir-sec {{S.cur ? 'cur' : ''}}" wx:for="{{C.secs}}" wx:for-item="S" wx:key="si"
                  data-si="{{S.si}}" hover-class="dir-row--press" hover-stay-time="60" bindtap="onDirSec">
              <view class="dir-dot {{S.done ? 'done' : ''}}"></view>
              <view class="dir-sec__t">{{S.kNo}}. {{S.title}}</view>
            </view>
          </view>
        </view>
      </block>
    </view>
  </block>
</view>

<!-- ② 章头 + 打卡 -->
<view class="card head-card">
  <!-- 方案 A：册/章号与节标题目录卡已有 → 章标题居中进导航行；目标与时长并成一行灰字 -->
  <view class="head-top">
    <view class="head-nav {{viewSec > 0 ? '' : 'head-nav--dis'}}" hover-class="{{viewSec > 0 ? 'head-nav--press' : 'none'}}" hover-stay-time="80" bindtap="prevSec">‹ 上一节</view>
    <view class="head-ch">{{chapterTitle}}</view>
    <view class="head-nav {{viewSec < totalSec - 1 ? '' : 'head-nav--dis'}}" hover-class="{{viewSec < totalSec - 1 ? 'head-nav--press' : 'none'}}" hover-stay-time="80" bindtap="nextSec">下一节 ›</view>
  </view>
  <view class="head-meta" wx:if="{{dayData.obj || dayData.time}}"><text wx:if="{{dayData.obj}}">目标：{{dayData.obj}}</text><text wx:if="{{dayData.obj && dayData.time}}"> · </text><text wx:if="{{dayData.time}}">约 {{dayData.time}}</text></view>
  <view class="is-today" wx:if="{{viewSec !== curSec}}" hover-class="hover-dim" hover-stay-time="120" bindtap="backToProgress">回到当前进度（第 {{curSec + 1}} / {{totalSec}} 节）</view>
  <view class="checkin-btn">
    <button class="btn-primary btn-fit" wx:if="{{!checked}}" hover-class="btn-press" hover-stay-time="0" bindtap="onCheckin">完成打卡<view class="ico ico-check" style="margin-left:var(--ico-gap);margin-right:0"></view></button>
    <view class="done-row" wx:else>
      <view class="done-state">本节已完成<view class="ico ico-check" style="margin-left:var(--ico-gap);margin-right:0"></view></view>
      <text class="done-dot">·</text>
      <view class="done-cancel" hover-class="hover-dim" hover-stay-time="120" bindtap="onCheckin" aria-role="button" aria-label="取消打卡">取消打卡</view>
    </view>
  </view>
</view>

<!-- ③ 本节词汇（一词一卡） -->
<view class="wbar">
  <view class="wbar__t">本节词汇<text class="wbar__n">{{cards.length}}</text></view>
  <button class="btn-ghost btn-speak-all {{playingMode === 'queue' ? 'btn-speak-all--active' : ''}}" hover-class="btn-press" bindtap="onSpeakAll"><view class="ico {{playingMode === 'queue' ? 'ico-stop' : 'ico-play'}}"></view>{{playingMode === 'queue' ? '停止朗读' : '朗读全部'}}</button>
</view>

<block wx:for="{{cards}}" wx:key="k">
  <view class="group-tag" wx:if="{{index === 0 && coreCount > 0}}">主题词 · {{coreCount}}</view>
  <view class="group-tag group-tag--extra" wx:if="{{index === extraStart}}">扩展词 · {{extraCount}}</view>
  <view class="card wcard {{hlWord === item.w ? 'wcard--hl' : ''}}" id="w{{index}}">
    <view class="wcard__head">
      <view class="wcard__main">
        <view class="word-head"><text class="word-en"><text wx:if="{{playingText === item.w && (playingKey === '' || playingKey === item.k)}}" class="kara-lit">{{karaLit}}</text>{{playingText === item.w && (playingKey === '' || playingKey === item.k) ? karaRest : item.w}}</text><text class="word-pos">{{item.p}}</text><view class="word-zh">{{item.m}}</view></view>
        <view class="ipa-row">
          <view class="ipa-mod {{playingText === item.w && (playingKey === '' || playingKey === item.k) && playingAccent === 'us' ? 'on' : ''}}"
                hover-class="speak-hover" hover-stay-time="120"
                data-text="{{item.w}}" data-k="{{item.k}}" data-ai="{{item.ai}}" data-kind="w" data-accent="us" bindtap="onSpeakWord"><view class="spk-ico {{playingText === item.w && (playingKey === '' || playingKey === item.k) && playingAccent === 'us' ? 'spk-ico--on' : ''}}"></view><text class="ipa-txt" wx:if="{{item.ipa}}">{{item.ipa}}</text></view>
          <view class="ipa-mod ipa-mod--uk {{playingText === item.w && (playingKey === '' || playingKey === item.k) && playingAccent === 'uk' ? 'on' : ''}}"
                wx:if="{{item.uk}}"
                hover-class="speak-hover" hover-stay-time="120"
                data-text="{{item.w}}" data-k="{{item.k}}" data-ai="{{item.ai}}" data-kind="w" data-accent="uk" bindtap="onSpeakWord"><view class="spk-ico {{playingText === item.w && (playingKey === '' || playingKey === item.k) && playingAccent === 'uk' ? 'spk-ico--on' : ''}}"></view><text class="ipa-txt">{{item.uk}}</text></view>
        </view>
        <!-- 变形（v1.1.110）：规则 + 不规则全列；点一下朗读该形式（词表内的走 w/ 桶） -->
        <view class="wf-line" wx:if="{{item.wf.length}}">
          <block wx:for="{{item.wf}}" wx:for-item="F" wx:key="form">
            <view class="wf-line__t" wx:if="{{F.speak === false}}">{{F.label}} {{F.form}}</view>
            <view class="wf-line__t {{wfKey === item.k + ':' + F.form ? 'wf-line__t--on' : ''}}" wx:else
                  hover-class="none" hover-stay-time="0"
                  data-text="{{F.form}}" data-key="{{item.k}}:{{F.form}}" catchtap="onSpeakWfToday">{{F.label}} {{F.form}}</view>
          </block>
        </view>
        <view class="hl-via" wx:if="{{hlWord === item.w && hlVia}}">「{{hlQ}}」是它的{{hlVia}}</view>
        <view class="word-example-row">
          <view class="word-example"
                data-text="{{item.e}}" data-ai="{{item.ai}}" data-kind="s" data-k="{{item.k}}" bindtap="onSpeakWord"><text wx:if="{{playingText === item.e && (playingKey === '' || playingKey === item.k)}}" class="kara-lit">{{karaLit}}</text>{{playingText === item.e && (playingKey === '' || playingKey === item.k) ? karaRest : item.e}}</view>
          <view class="ex-speak {{playingText === item.e && (playingKey === '' || playingKey === item.k) ? 'playing' : ''}}"
                hover-class="speak-hover" hover-stay-time="120"
                data-text="{{item.e}}" data-ai="{{item.ai}}" data-kind="s" data-k="{{item.k}}" bindtap="onSpeakWord"><view class="spk-ico {{playingText === item.e && (playingKey === '' || playingKey === item.k) ? 'spk-ico--on' : ''}}"></view></view>
          <view class="ex-eye" wx:if="{{item.cn}}" hover-class="none" hover-stay-time="120" data-k="{{item.k}}" catchtap="onToggleExZh"><view class="eye-ico {{zhOpen[item.k] ? 'eye-ico--on' : ''}}"></view></view>
        </view>
        <view class="ex-cn" wx:if="{{item.cn && zhOpen[item.k]}}">{{item.cn}}</view>
      </view>
      <view class="word-star {{item.starred ? 'on' : ''}}" data-index="{{index}}" hover-class="hover-dim" hover-stay-time="120" bindtap="onStar"><view class="star-ico {{item.starred ? 'star-ico--on' : 'star-ico--off'}}"></view></view>
    </view>

    <!-- 另一读音 / 词义（同一张卡，虚线以下） -->
    <block wx:if="{{item.sub}}">
      <view class="wcard__sub">
        <view class="wcard__sub-t">另一读音 · {{item.sub.p}}</view>
        <view class="word-head"><view class="word-zh wcard__sub-m">{{item.sub.m}}</view></view>
        <view class="ipa-row">
          <view class="ipa-mod {{playingText === item.w && playingKey === item.sub.k && playingAccent === 'us' ? 'on' : ''}}"
                wx:if="{{item.sub.ipa}}"
                hover-class="speak-hover" hover-stay-time="120"
                data-text="{{item.w}}" data-k="{{item.sub.k}}" data-ai="{{item.sub.ai}}" data-kind="w" data-accent="us" bindtap="onSpeakWord"><view class="spk-ico {{playingText === item.w && playingKey === item.sub.k && playingAccent === 'us' ? 'spk-ico--on' : ''}}"></view><text class="ipa-txt">{{item.sub.ipa}}</text></view>
          <view class="ipa-mod ipa-mod--uk {{playingText === item.w && playingKey === item.sub.k && playingAccent === 'uk' ? 'on' : ''}}"
                wx:if="{{item.sub.uk}}"
                hover-class="speak-hover" hover-stay-time="120"
                data-text="{{item.w}}" data-k="{{item.sub.k}}" data-ai="{{item.sub.ai}}" data-kind="w" data-accent="uk" bindtap="onSpeakWord"><view class="spk-ico {{playingText === item.w && playingKey === item.sub.k && playingAccent === 'uk' ? 'spk-ico--on' : ''}}"></view><text class="ipa-txt">{{item.sub.uk}}</text></view>
        </view>
        <view class="wf-line" wx:if="{{item.sub.wf.length}}">
          <block wx:for="{{item.sub.wf}}" wx:for-item="F" wx:key="form">
            <view class="wf-line__t" wx:if="{{F.speak === false}}">{{F.label}} {{F.form}}</view>
            <view class="wf-line__t {{wfKey === item.sub.k + ':' + F.form ? 'wf-line__t--on' : ''}}" wx:else
                  hover-class="none" hover-stay-time="0"
                  data-text="{{F.form}}" data-key="{{item.sub.k}}:{{F.form}}" catchtap="onSpeakWfToday">{{F.label}} {{F.form}}</view>
          </block>
        </view>
        <view class="word-example-row">
          <view class="word-example"
                data-text="{{item.sub.e}}" data-ai="{{item.sub.ai}}" data-kind="s" data-k="{{item.sub.k}}" bindtap="onSpeakWord"><text wx:if="{{playingText === item.sub.e && playingKey === item.sub.k}}" class="kara-lit">{{karaLit}}</text>{{playingText === item.sub.e && playingKey === item.sub.k ? karaRest : item.sub.e}}</view>
          <view class="ex-speak {{playingText === item.sub.e && playingKey === item.sub.k ? 'playing' : ''}}"
                hover-class="speak-hover" hover-stay-time="120"
                data-text="{{item.sub.e}}" data-ai="{{item.sub.ai}}" data-kind="s" data-k="{{item.sub.k}}" bindtap="onSpeakWord"><view class="spk-ico {{playingText === item.sub.e && playingKey === item.sub.k ? 'spk-ico--on' : ''}}"></view></view>
          <view class="ex-eye" wx:if="{{item.sub.cn}}" hover-class="none" hover-stay-time="120" data-k="{{item.sub.k}}" catchtap="onToggleExZh"><view class="eye-ico {{zhOpen[item.sub.k] ? 'eye-ico--on' : ''}}"></view></view>
        </view>
        <view class="ex-cn" wx:if="{{item.sub.cn && zhOpen[item.sub.k]}}">{{item.sub.cn}}</view>
      </view>
    </block>
  </view>
</block>

<!-- ④ 章末自测（旧版的周日自检）：只展示，不打卡、不占进度 -->
<view class="card quiz-card" wx:if="{{dayData.quiz}}">
  <view class="section-label">本章自测 · 可选</view>
  <view class="quiz-t">{{dayData.quiz.t}}</view>
  <view class="obj-text" wx:if="{{dayData.quiz.obj}}">目标：{{dayData.quiz.obj}}</view>
  <view class="practice-line" wx:for="{{quizLines}}" wx:key="no"><text class="prac-no">{{item.no}}.</text><text>{{item.text}}</text></view>
  <view class="tip-text" wx:if="{{dayData.quiz.tip}}">{{dayData.quiz.tip}}</view>
  <view class="quiz-note">不打卡、不计进度 —— 想休息就跳过。</view>
</view>

<!-- ⑤ 例句精读 -->
<view class="card" wx:if="{{dayData.g}}">
  <view class="section-label">{{dayData.g.label || '例句精读'}} · {{dayData.g.t}}</view>
  <view class="grammar-exp">{{dayData.g.exp}}</view>
  <view class="grammar-ex {{dayData.g.plain ? 'grammar-ex--sup' : ''}}" wx:for="{{dayData.g.ex}}" wx:key="v">
    <view class="ex-no" wx:if="{{!dayData.g.plain}}">{{index + 1}}.</view>
    <text class="grammar-ex-text"><text wx:if="{{playingText === item.v}}" class="kara-lit">{{karaLit}}</text>{{playingText === item.v ? karaRest : item.v}}</text>
    <view class="ex-speak {{playingText === item.v ? 'playing' : ''}}" wx:if="{{item.spk}}"
          hover-class="speak-hover" hover-stay-time="120"
          data-text="{{item.v}}" data-kind="g" bindtap="onSpeakWord"><view class="spk-ico {{playingText === item.v ? 'spk-ico--on' : ''}}"></view></view>
  </view>
</view>

<!-- ⑥ 练习任务 -->
<view class="card" wx:if="{{dayData.pr}}">
  <view class="section-label">练习任务</view>
  <view class="practice-line" wx:for="{{prLines}}" wx:key="no"><text class="prac-no">{{item.no}}.</text><text>{{item.text}}</text></view>
</view>

<!-- ⑦ 学习提示 -->
<view class="card tip-box" wx:if="{{dayData.tip}}">
  <view class="section-label">学习提示</view>
  <view class="tip-text">{{dayData.tip}}</view>
</view>
</block>

<feedback id="fb"/>
</view>
